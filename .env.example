# Copy to .env and change the values:  cp .env.example .env
# .env is git-ignored. These are local/demo settings, not production secrets.

# SQL Server 'sa' password: 8+ characters with upper, lower, digit and symbol.
SA_PASSWORD=Local_Dev_Passw0rd!

# JWT signing key: at least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-output-of-openssl-rand-base64-48

# Who can register. Comma-free single domain for the demo; add more in appsettings.json.
ALLOWED_EMAIL_DOMAIN=company.com

# Refresh cookie Secure flag. Chrome and Firefox accept Secure cookies on http://localhost;
# Safari doesn't, so this defaults to false for the local Docker setup. Use true behind HTTPS.
COOKIE_SECURE=false

# Demo accounts created on first start (use these to sign in, or register your own).
DEMO_USER_1_EMAIL=alex.morgan@company.com
DEMO_USER_1_NAME="Alex Morgan"
DEMO_USER_1_PASSWORD=orchard-kettle-2026
DEMO_USER_2_EMAIL=priya.nair@company.com
DEMO_USER_2_NAME="Priya Nair"
DEMO_USER_2_PASSWORD=harbour-lantern-47
